---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

const title = "About — Scarlett Gately Moore";
const description = "About Scarlett Gately Moore — Linux distribution engineer, KDE and Kubuntu contributor, and open-source developer.";
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <style>
      .grid-bg {
        position: fixed;
        inset: 0;
        background-image:
          linear-gradient(rgba(55,138,221,0.04) 1px, transparent 1px),
          linear-gradient(90deg, rgba(55,138,221,0.04) 1px, transparent 1px);
        background-size: 40px 40px;
        pointer-events: none;
        z-index: 0;
      }
      .orb {
        position: fixed;
        width: 600px;
        height: 600px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(24,95,165,0.15) 0%, transparent 70%);
        top: -200px;
        right: -200px;
        pointer-events: none;
        z-index: 0;
      }
      main {
        position: relative;
        z-index: 1;
        max-width: 720px;
        width: calc(100% - 4rem);
        margin: 0 auto;
        padding: 4rem 0;
        animation: fadeUp 0.6s ease forwards;
      }
      .page-tag {
        font-family: 'Space Mono', monospace;
        font-size: 11px;
        color: var(--accent);
        letter-spacing: 0.15em;
        text-transform: uppercase;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .page-tag::before {
        content: '';
        display: inline-block;
        width: 24px;
        height: 1px;
        background: var(--accent);
      }
      .prose h1 {
        font-family: 'Space Mono', monospace;
        font-size: clamp(1.8rem, 4vw, 2.6rem);
        font-weight: 700;
        color: var(--text);
        margin-bottom: 2rem;
        line-height: 1.2;
      }
      .prose h2 {
        font-family: 'Space Mono', monospace;
        font-size: 1rem;
        font-weight: 700;
        color: var(--accent);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        margin: 2.5rem 0 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid var(--blue-border);
      }
      .prose p {
        font-size: 16px;
        color: var(--text-muted);
        line-height: 1.8;
        margin-bottom: 1.25rem;
      }
      .prose strong { color: var(--text); font-weight: 500; }
      .prose ul {
        list-style: none;
        padding: 0;
        margin: 0 0 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
      }
      .prose ul li {
        font-size: 15px;
        color: var(--text-muted);
        line-height: 1.6;
        padding-left: 1.25rem;
        position: relative;
      }
      .prose ul li::before {
        content: '//';
        position: absolute;
        left: 0;
        font-family: 'Space Mono', monospace;
        font-size: 11px;
        color: var(--accent);
        top: 3px;
      }
      .prose a {
        color: var(--accent);
        text-decoration: none;
        border-bottom: 1px solid var(--blue-border);
        transition: border-color 0.2s;
      }
      .prose a:hover { border-bottom-color: var(--accent); }
      .contact-grid {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        margin-top: 1rem;
      }
      .contact-row {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0.75rem 1rem;
        background: var(--bg2);
        border: 1px solid var(--blue-border);
        border-radius: 6px;
        text-decoration: none;
        transition: border-color 0.2s, background 0.2s;
      }
      .contact-row:hover {
        border-color: var(--accent);
        background: var(--bg3);
      }
      .contact-label {
        font-family: 'Space Mono', monospace;
        font-size: 11px;
        color: var(--accent);
        letter-spacing: 0.05em;
        min-width: 70px;
      }
      .contact-value {
        font-size: 14px;
        color: var(--text-muted);
      }
      @keyframes fadeUp {
        from { opacity: 0; transform: translateY(16px); }
        to { opacity: 1; transform: translateY(0); }
      }
    </style>
  </head>
  <body>
    <div class="grid-bg"></div>
    <div class="orb"></div>
    <Header />
    <main>
      <div class="page-tag">about</div>
      <div class="prose">
        <h1>Hi, I'm Scarlett.</h1>

        <p>
          I'm an open source developer with 11+ years of experience in Linux distribution
          development, software packaging, and CI/CD infrastructure — and recently, an
          Apache County property tax appraiser in training.
        </p>

        <h2>The open source side</h2>

        <p>
          I've spent more than a decade contributing to the Linux ecosystem, with deep roots
          in the KDE and Ubuntu communities. My work has covered distribution leadership,
          packaging, release engineering, and the infrastructure that keeps projects moving.
          Over the years I've worn a lot of hats:
        </p>

        <ul>
          <li><strong>Kubuntu Developer</strong> — contributor to Kubuntu development and member of the Kubuntu Council</li>
          <li><strong>Debian Developer</strong> — official Debian Developer with upload privileges; contributing to package maintenance, reproducible builds, LTS security updates, and distribution quality</li>
          <li><strong>KDE DevOps Engineer</strong> — architected CI/CD infrastructure supporting hundreds of KDE applications and thousands of developers worldwide</li>
          <li><strong>Netrunner Distribution</strong> — project manager for a community-driven Linux distribution through multiple stable release cycles</li>
        </ul>

        <p>
          I've worked extensively with Jenkins, GitLab CI, Docker, LXD, Snap, AppImage,
          and multi-architecture builds across AMD64, ARM64, and ARMHF. My packaging work
          spans Python, Ruby, C/C++, and Bash, and I've upstreamed improvements across
          Debian, Ubuntu, and KDE.
        </p>

        <h2>Finding my way into Kubuntu</h2>

        <p>
          My KDE story and my Kubuntu story began side by side. After my first KDE
          documentation contributions in 2012, <strong>Jonathan Riddell</strong> — one
          of the people whose work made Kubuntu possible — approached me and asked
          whether I'd be interested in helping with the project. I said yes, and that
          invitation began my journey into Linux packaging.
        </p>

        <p>
          It was an especially interesting time to join. KDE was breaking up the
          monolithic kdelibs codebase into the smaller, modular KDE Frameworks, and I
          helped package that major transition for Kubuntu and get the work integrated
          into Ubuntu. That was my introduction to the depth and complexity of
          distribution packaging: not just building software, but making a large,
          interconnected stack work reliably for users.
        </p>

        <p>
          In those early days, Kubuntu had a remarkable team. We worked hard, built
          things together, and for a while became a familiar part of the wider Linux
          ecosystem. A number of us eventually went on to help form what became KDE
          Neon: KDE software, built on an Ubuntu LTS foundation, with continuous
          integration driving the development and delivery process.
        </p>

        <p>
          Over time, the team went in different directions, moving on to different
          projects and careers. KDE Neon is still alive today, sustained by a very
          small volunteer effort. I'm no longer part of its day-to-day maintenance,
          but the work we did together remains an important part of my history in KDE
          and Ubuntu.
        </p>

        <h2>Returning to Kubuntu</h2>

        <p>
          My Kubuntu story didn't end with those early years. I was later brought back
          for the Noble release. It was a chance to return to a project that had been
          a formative part of my career, and to contribute again as a Kubuntu Developer.
        </p>

        <p>
          More recently, <a href="https://kfocus.com/" target="_blank" rel="noopener noreferrer">Kubuntu Focus</a>
          brought me on for the Resolute LTS release and the early stages of the
          Bulletproof Linux work. That effort has since transitioned to
          <a href="https://techpaladinsoftware.com/" target="_blank" rel="noopener noreferrer">Techpaladin</a>,
          a new company formed by members of the Blue Systems team. It's another
          continuation of the same thread running through my career: building,
          integrating, and supporting KDE-based systems on a dependable Ubuntu foundation.
        </p>

        <h2>Growing KDE Snaps from an idea</h2>

        <p>
          KDE Snaps have been one of the longest-running and most hands-on parts of my
          open-source work. I was at the conference where Canonical introduced the Snap
          concept. After the presentation, I approached the speaker and asked whether it
          would be okay to take that concept and use it to create Snaps for KDE applications.
          They were enthusiastic about the idea, and that conversation helped set the KDE
          Snaps effort in motion — a project that has stayed with me ever since.
        </p>

        <p>
          I've been involved with KDE Snaps from those early days and have been their
          solo maintainer for much of their existence. That has meant far more than
          packaging applications: it has meant keeping the infrastructure working,
          solving build and runtime problems, adapting to changes in Snapcraft and the
          KDE stack, and doing the persistent maintenance that keeps software available
          to users. A lot of that work has happened behind the scenes, one bug, build,
          and release at a time.
        </p>

        <p>
          Much of this has been volunteer work — a substantial investment of time,
          energy, and plenty of blood, sweat, and tears — with the occasional short-term
          contract along the way. I'm especially glad that the work is being funded
          now. Being paid for it is a welcome change, and a meaningful recognition of
          the years of effort that went into building and sustaining it.
        </p>

        <p>
          The work is still evolving. I'm currently focused on the next generation of
          KDE Snap infrastructure, including KDE Neon support in Snapcraft and the
          move toward Core26 runtimes. It's a continuation of that original conversation:
          taking an idea and doing the practical, sometimes difficult engineering needed
          to make it real and keep it going.
        </p>

        <h2>Developing the KDE Neon Core vision</h2>

        <p>
          My work with KDE has also extended into product and business planning. I developed
          a full business plan for <strong>KDE Neon Core</strong> — a complete operating
          system initiative built on Ubuntu Core, distinct from the existing KDE Neon
          desktop distribution. Although I didn't ultimately lead the project myself,
          <a href="https://www.enioka.com/" target="_blank" rel="noopener noreferrer">enioka</a>
          took up my proposal and brought it forward, helping deliver the work for Core24.
        </p>

        <p>
          When enioka was engaged again for Core26, they invited me back to contribute.
          It's been rewarding to see the KDE Neon Core vision continue to evolve, and to
          be part of the next stage of that work.
        </p>

        <p>
          I have also served for the past two years on the <strong>Ubuntu Community Council</strong>,
          contributing to community governance and the wider Ubuntu community. That service is
          an important part of my open-source work and community involvement.
        </p>

        <p>I hold a BS in Computer Information Systems from DeVry University.</p>

        <h2>The day job</h2>

        <p>
          In a bit of a career pivot, I'm now venturing into <strong>property appraisal
          with Apache County, Arizona</strong> as a Property Appraiser I. Arizona's dual
          valuation system, legal classifications, assessment ratios, and the three
          approaches to value keep things interesting. I'm enjoying learning an entirely
          new discipline from the ground up.
        </p>

        <p>
          St. Johns is a long way from a Jenkins server, but the systematic thinking
          translates surprisingly well.
        </p>

        <h2>This blog</h2>

        <p>
          This is my engineering notebook: a place for practical write-ups about Linux, KDE,
          Kubuntu, Snapcraft, packaging, CI/CD, and the occasional lesson from working
          across two very different disciplines.
        </p>

        <h2>Get in touch</h2>
      </div>

      <div class="contact-grid">
        <a class="contact-row" href="mailto:sgmoore@debian.org">
          <span class="contact-label">email</span>
          <span class="contact-value">sgmoore@debian.org</span>
        </a>
        <a class="contact-row" href="https://github.com/scarlettgatelymoore" target="_blank">
          <span class="contact-label">github</span>
          <span class="contact-value">github.com/scarlettgatelymoore</span>
        </a>
        <a class="contact-row" href="https://www.linkedin.com/in/scarlettgatelymoore" target="_blank">
          <span class="contact-label">linkedin</span>
          <span class="contact-value">linkedin.com/in/scarlettgatelymoore</span>
        </a>
      </div>
    </main>
    <Footer />
  </body>
</html>
